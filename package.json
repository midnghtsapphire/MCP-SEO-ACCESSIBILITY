### 7. src/services/seoService.ts
import axios from 'axios';
import { SEOData, AccessibilityData } from '../db/schema';
export async function getSEOData(url: string): Promise<any> {
  const response = await axios.get(`https://api.seo.com/data?url=${url}`);
  const data = new SEOData({ url, data: response.data });
  await data.save();
  return data;
}
export async function getAccessibilityReport(url: string): Promise<any> {
  const response = await axios.get(`https://api.accessibility.com/report?url=${url}`);
  const report = new AccessibilityData({ url, report: response.data });
  await report.save();
  return report;
}